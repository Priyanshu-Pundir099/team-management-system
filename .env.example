# PostgreSQL connection string
# For local dev: jdbc:postgresql://localhost:5432/teamtask
DATABASE_URL=jdbc:postgresql://localhost:5432/teamtask
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT secret — min 32 characters, keep it secret!
JWT_SECRET=super-secret-key-change-in-production-min-32-chars

# Allowed CORS origin (React dev server)
FRONTEND_URL=http://localhost:5173
